diff --git a/NexusPVR/Features/Player/ExternalDisplayManager.swift b/NexusPVR/Features/Player/ExternalDisplayManager.swift
new file mode 100644
index 0000000..c2a2792
--- /dev/null
+++ b/NexusPVR/Features/Player/ExternalDisplayManager.swift
@@ -0,0 +1,164 @@
+//
+//  ExternalDisplayManager.swift
+//  nextpvr-apple-client
+//
+//  Video on an external display (a TV on HDMI/USB-C, or AirPlay) while the
+//  iPhone/iPad keeps the player controls.
+//
+//  How it works: the app declares an external-display scene (see the
+//  `UIApplicationSceneManifest` injected by the build workflow). When a display
+//  is connected, UIKit creates that scene instead of mirroring, and
+//  `ExternalSceneDelegate` puts a black window on it. While a stream plays with
+//  the pixel-buffer renderer, the shared `AVSampleBufferDisplayLayer` is moved
+//  from the player view into that window; the player view on the device keeps
+//  the controls over a black background.
+//
+//  Without the scene manifest nothing here is triggered and iOS just mirrors
+//  the screen, as before.
+//
+//  Only the pixel-buffer renderer is supported: the Metal and OpenGL renderers
+//  draw into a surface owned by their own view and cannot be shown twice.
+//
+
+#if os(iOS)
+
+import UIKit
+import AVFoundation
+
+extension Notification.Name {
+    /// Posted when an external display scene connects or disconnects.
+    static let externalDisplayChanged = Notification.Name("externalDisplayChanged")
+}
+
+@MainActor
+final class ExternalDisplayManager {
+    static let shared = ExternalDisplayManager()
+
+    private var window: UIWindow?
+    private var hostView: ExternalVideoHostView?
+
+    /// An external display scene is attached.
+    private(set) var isConnected = false
+
+    /// The video layer currently lives on the external display.
+    var isHostingVideo: Bool { hostView?.hasVideo ?? false }
+
+    private init() {}
+
+    func attach(to scene: UIWindowScene) {
+        let window = UIWindow(windowScene: scene)
+        let host = ExternalVideoHostView(frame: window.bounds)
+        let controller = UIViewController()
+        controller.view = host
+        window.rootViewController = controller
+        window.isHidden = false
+        self.window = window
+        hostView = host
+        isConnected = true
+        NotificationCenter.default.post(name: .externalDisplayChanged, object: nil)
+    }
+
+    func detach() {
+        hostView?.removeVideo()
+        hostView = nil
+        window?.isHidden = true
+        window = nil
+        isConnected = false
+        NotificationCenter.default.post(name: .externalDisplayChanged, object: nil)
+    }
+
+    /// Puts the video layer on the external display. Returns `false` when there
+    /// is none, in which case the caller keeps the layer in its own view.
+    func host(layer: AVSampleBufferDisplayLayer, session: any ActivePlayerSessionManaging) -> Bool {
+        guard let hostView else { return false }
+        hostView.show(layer: layer, session: session)
+        return true
+    }
+
+    /// Re-fits the video on the external display (e.g. after an aspect change).
+    func relayout() {
+        hostView?.setNeedsLayout()
+    }
+
+    /// Playback ended: back to the idle screen.
+    func releaseVideo() {
+        hostView?.removeVideo()
+    }
+}
+
+/// Black ground of the external display that holds the video layer.
+@MainActor
+final class ExternalVideoHostView: UIView {
+    private weak var videoLayer: AVSampleBufferDisplayLayer?
+    private weak var session: (any ActivePlayerSessionManaging)?
+    private let idleLabel = UILabel()
+
+    var hasVideo: Bool { videoLayer != nil }
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        backgroundColor = .black
+        autoresizingMask = [.flexibleWidth, .flexibleHeight]
+        idleLabel.text = "StreamClient"
+        idleLabel.textColor = UIColor(white: 1, alpha: 0.35)
+        idleLabel.font = .systemFont(ofSize: 40, weight: .semibold)
+        idleLabel.sizeToFit()
+        addSubview(idleLabel)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    func show(layer: AVSampleBufferDisplayLayer, session: any ActivePlayerSessionManaging) {
+        self.session = session
+        videoLayer = layer
+        idleLabel.isHidden = true
+        if layer.superlayer !== self.layer {
+            self.layer.addSublayer(layer)
+        }
+        setNeedsLayout()
+    }
+
+    func removeVideo() {
+        videoLayer?.removeFromSuperlayer()
+        videoLayer = nil
+        session = nil
+        idleLabel.isHidden = false
+        setNeedsLayout()
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        idleLabel.center = CGPoint(x: bounds.midX, y: bounds.midY)
+        guard let videoLayer else { return }
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        if let aspect = session?.player?.videoDisplayAspect {
+            videoLayer.videoGravity = .resize
+            videoLayer.frame = VideoAspectCorrection.fittedRect(displayAspect: aspect, in: bounds)
+        } else {
+            videoLayer.videoGravity = .resizeAspect
+            videoLayer.frame = bounds
+        }
+        CATransaction.commit()
+    }
+}
+
+/// Scene delegate for the external display. Referenced by name from the
+/// `UIApplicationSceneManifest` in Info.plist.
+@objc(ExternalSceneDelegate)
+final class ExternalSceneDelegate: UIResponder, UIWindowSceneDelegate {
+    var window: UIWindow?
+
+    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {
+        guard let windowScene = scene as? UIWindowScene else { return }
+        ExternalDisplayManager.shared.attach(to: windowScene)
+    }
+
+    func sceneDidDisconnect(_ scene: UIScene) {
+        ExternalDisplayManager.shared.detach()
+    }
+}
+
+#endif
