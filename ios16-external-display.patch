diff --git a/NexusPVR/Compat/ScrollGeometryObserver.swift b/NexusPVR/Compat/ScrollGeometryObserver.swift
new file mode 100644
index 0000000..646019b
--- /dev/null
+++ b/NexusPVR/Compat/ScrollGeometryObserver.swift
@@ -0,0 +1,100 @@
+//
+//  ScrollGeometryObserver.swift
+//  nextpvr-apple-client
+//
+//  `onScrollGeometryChange` needs iOS 18. This reads the same numbers from the
+//  enclosing UIScrollView, so the guide grid works on iOS 16 and 17.
+//
+
+#if os(iOS)
+
+import SwiftUI
+import UIKit
+
+/// Place it in a `.background` *inside* the scroll content: it walks up to the
+/// enclosing `UIScrollView` and reports `(previous offset, current offset,
+/// visible size)` whenever the offset or the visible size changes.
+struct ScrollGeometryObserver: UIViewRepresentable {
+    let onChange: (CGPoint, CGPoint, CGSize) -> Void
+
+    func makeCoordinator() -> Coordinator {
+        Coordinator()
+    }
+
+    func makeUIView(context: Context) -> UIView {
+        let view = HostView(frame: .zero)
+        view.isUserInteractionEnabled = false
+        view.backgroundColor = .clear
+        context.coordinator.onChange = onChange
+        let coordinator = context.coordinator
+        view.onMovedToWindow = { [weak view, weak coordinator] in
+            guard let view, let coordinator else { return }
+            coordinator.attach(from: view)
+        }
+        return view
+    }
+
+    func updateUIView(_ uiView: UIView, context: Context) {
+        context.coordinator.onChange = onChange
+    }
+
+    final class HostView: UIView {
+        var onMovedToWindow: (() -> Void)?
+
+        override func didMoveToWindow() {
+            super.didMoveToWindow()
+            if window != nil { onMovedToWindow?() }
+        }
+    }
+
+    @MainActor
+    final class Coordinator {
+        var onChange: ((CGPoint, CGPoint, CGSize) -> Void)?
+        private weak var scrollView: UIScrollView?
+        private var offsetObservation: NSKeyValueObservation?
+        private var boundsObservation: NSKeyValueObservation?
+        private var lastOffset: CGPoint = .zero
+        private var lastSize: CGSize = .zero
+
+        func attach(from host: UIView) {
+            guard scrollView == nil else { return }
+            var parent: UIView? = host.superview
+            while let current = parent {
+                if let found = current as? UIScrollView {
+                    observe(found)
+                    return
+                }
+                parent = current.superview
+            }
+        }
+
+        private func observe(_ scrollView: UIScrollView) {
+            self.scrollView = scrollView
+            lastOffset = scrollView.contentOffset
+            offsetObservation = scrollView.observe(\.contentOffset, options: [.new]) { [weak self] _, _ in
+                MainActor.assumeIsolated { self?.report(initial: false) }
+            }
+            boundsObservation = scrollView.observe(\.bounds, options: [.new]) { [weak self] _, _ in
+                MainActor.assumeIsolated { self?.report(initial: false) }
+            }
+            report(initial: true)
+        }
+
+        private func report(initial: Bool) {
+            guard let scrollView else { return }
+            let offset = scrollView.contentOffset
+            let inset = scrollView.adjustedContentInset
+            let size = CGSize(
+                width: scrollView.bounds.width - inset.left - inset.right,
+                height: scrollView.bounds.height - inset.top - inset.bottom
+            )
+            if !initial && offset == lastOffset && size == lastSize { return }
+            let previous = initial ? offset : lastOffset
+            lastOffset = offset
+            lastSize = size
+            onChange?(previous, offset, size)
+        }
+    }
+}
+
+#endif
diff --git a/NexusPVR/Compat/iOS16Compat.swift b/NexusPVR/Compat/iOS16Compat.swift
new file mode 100644
index 0000000..1e0bf26
--- /dev/null
+++ b/NexusPVR/Compat/iOS16Compat.swift
@@ -0,0 +1,140 @@
+//
+//  iOS16Compat.swift
+//  nextpvr-apple-client
+//
+//  Stand-ins for SwiftUI APIs that only exist on iOS 17+ (or 16.4+), so the
+//  app can run on iOS 16. Each helper uses the real API where the system has
+//  it and degrades quietly where it doesn't.
+//
+
+import SwiftUI
+
+// MARK: - onChange (the iOS 17 overloads)
+
+private struct OnChangeOldNew<Value: Equatable>: ViewModifier {
+    let value: Value
+    let initial: Bool
+    let action: (Value, Value) -> Void
+    @State private var previous: Value
+
+    init(value: Value, initial: Bool, action: @escaping (Value, Value) -> Void) {
+        self.value = value
+        self.initial = initial
+        self.action = action
+        _previous = State(initialValue: value)
+    }
+
+    func body(content: Content) -> some View {
+        content
+            .onChange(of: value) { newValue in
+                let oldValue = previous
+                previous = newValue
+                action(oldValue, newValue)
+            }
+            .onAppear {
+                if initial { action(value, value) }
+            }
+    }
+}
+
+extension View {
+    /// `onChange(of:initial:_:)` with the old and the new value (iOS 17).
+    func onChangeCompat<Value: Equatable>(
+        of value: Value,
+        initial: Bool = false,
+        _ action: @escaping (_ oldValue: Value, _ newValue: Value) -> Void
+    ) -> some View {
+        modifier(OnChangeOldNew(value: value, initial: initial, action: action))
+    }
+
+    /// `onChange(of:initial:_:)` with no parameters (iOS 17).
+    func onChangeCompat<Value: Equatable>(
+        of value: Value,
+        initial: Bool = false,
+        _ action: @escaping () -> Void
+    ) -> some View {
+        modifier(OnChangeOldNew(value: value, initial: initial) { _, _ in action() })
+    }
+}
+
+// MARK: - Modifiers that arrived after iOS 16.0
+
+extension View {
+    /// `safeAreaPadding(.top, 0)` (iOS 17). Zero padding, so nothing to do before.
+    @ViewBuilder
+    func safeAreaPaddingTopZeroCompat() -> some View {
+        if #available(iOS 17.0, macOS 14.0, tvOS 17.0, *) {
+            safeAreaPadding(.top, 0)
+        } else {
+            self
+        }
+    }
+
+    /// `scrollBounceBehavior(.basedOnSize)` (iOS 16.4).
+    @ViewBuilder
+    func scrollBounceBasedOnSizeCompat() -> some View {
+        if #available(iOS 16.4, macOS 13.3, tvOS 16.4, *) {
+            scrollBounceBehavior(.basedOnSize)
+        } else {
+            self
+        }
+    }
+
+    /// `presentationBackground(_:)` (iOS 16.4).
+    @ViewBuilder
+    func presentationBackgroundCompat<S: ShapeStyle>(_ style: S) -> some View {
+        if #available(iOS 16.4, macOS 13.3, tvOS 16.4, *) {
+            presentationBackground(style)
+        } else {
+            self
+        }
+    }
+
+    /// `presentationCompactAdaptation(.popover)` (iOS 16.4).
+    @ViewBuilder
+    func presentationCompactPopoverCompat() -> some View {
+        if #available(iOS 16.4, macOS 13.3, tvOS 16.4, *) {
+            presentationCompactAdaptation(.popover)
+        } else {
+            self
+        }
+    }
+}
+
+// MARK: - UnevenRoundedRectangle (iOS 17)
+
+struct UnevenRoundedRectangleCompat: Shape {
+    var topLeadingRadius: CGFloat = 0
+    var bottomLeadingRadius: CGFloat = 0
+    var bottomTrailingRadius: CGFloat = 0
+    var topTrailingRadius: CGFloat = 0
+
+    func path(in rect: CGRect) -> Path {
+        let limit = min(rect.width, rect.height) / 2
+        let tl = min(max(topLeadingRadius, 0), limit)
+        let bl = min(max(bottomLeadingRadius, 0), limit)
+        let br = min(max(bottomTrailingRadius, 0), limit)
+        let tr = min(max(topTrailingRadius, 0), limit)
+
+        var path = Path()
+        path.move(to: CGPoint(x: rect.minX + tl, y: rect.minY))
+        path.addLine(to: CGPoint(x: rect.maxX - tr, y: rect.minY))
+        path.addArc(tangent1End: CGPoint(x: rect.maxX, y: rect.minY),
+                    tangent2End: CGPoint(x: rect.maxX, y: rect.minY + tr),
+                    radius: tr)
+        path.addLine(to: CGPoint(x: rect.maxX, y: rect.maxY - br))
+        path.addArc(tangent1End: CGPoint(x: rect.maxX, y: rect.maxY),
+                    tangent2End: CGPoint(x: rect.maxX - br, y: rect.maxY),
+                    radius: br)
+        path.addLine(to: CGPoint(x: rect.minX + bl, y: rect.maxY))
+        path.addArc(tangent1End: CGPoint(x: rect.minX, y: rect.maxY),
+                    tangent2End: CGPoint(x: rect.minX, y: rect.maxY - bl),
+                    radius: bl)
+        path.addLine(to: CGPoint(x: rect.minX, y: rect.minY + tl))
+        path.addArc(tangent1End: CGPoint(x: rect.minX, y: rect.minY),
+                    tangent2End: CGPoint(x: rect.minX + tl, y: rect.minY),
+                    radius: tl)
+        path.closeSubpath()
+        return path
+    }
+}
